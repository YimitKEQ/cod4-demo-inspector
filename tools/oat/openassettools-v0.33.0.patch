+namespace
+{
+    std::string Quote(const char* text)
+    {
+        std::string out = "\"";
+        if (text)
+        {
+            for (const char* c = text; *c; c++)
+            {
+                const auto ch = static_cast<unsigned char>(*c);
+                if (ch == '"' || ch == '\\')
+                {
+                    out += '\\';
+                    out += static_cast<char>(ch);
+                }
+                else if (ch < 0x20)
+                {
+                    std::ostringstream hex;
+                    hex << "\\u" << std::hex << std::setw(4) << std::setfill('0') << static_cast<int>(ch);
+                    out += hex.str();
+                }
+                else
+                    out += static_cast<char>(ch);
+            }
+        }
+        out += "\"";
+        return out;
+    }
+
+    std::string BaseName(const std::string& assetName)
+    {
+        // "maps/mp/mp_bog.d3dbsp" -> "maps/mp/mp_bog"
+        const auto dot = assetName.rfind('.');
+        return dot == std::string::npos ? assetName : assetName.substr(0, dot);
+    }
+
+    void WriteFloats(std::ostream& out, const float* values, const size_t count)
+    {
+        out << "[";
+        for (size_t i = 0; i < count; i++)
+            out << (i ? "," : "") << values[i];
+        out << "]";
+    }
+
+    // Raw pixel data of an image that lives inside the zone, if it does.
+    // Returns false when the image is streamed from an .iwd instead.
+    bool DumpLoadDef(const AssetDumpingContext& context, const GfxImage* image, const std::string& fileName, std::ostream& json)
+    {
+        if (!image || !image->texture.loadDef || image->texture.loadDef->resourceSize == 0)
+            return false;
+
+        const auto* def = image->texture.loadDef;
+        const auto file = context.OpenAssetFile(fileName);
+        if (!file)
+            return false;
+        file->write(def->data, def->resourceSize);
+
+        json << "{\"name\":" << Quote(image->name) << ",\"file\":" << Quote(fileName.c_str()) << ",\"width\":" << image->width
+             << ",\"height\":" << image->height << ",\"depth\":" << image->depth << ",\"format\":" << def->format
+             << ",\"levels\":" << static_cast<int>(def->levelCount) << ",\"bytes\":" << def->resourceSize << "}";
+        return true;
+    }
+
+    void WriteMaterial(std::ostream& json, const Material* material)
+    {
+        json << "{\"name\":" << Quote(material->info.name);
+        json << ",\"techset\":" << Quote(material->techniqueSet ? material->techniqueSet->name : "");
+        json << ",\"sortKey\":" << static_cast<int>(material->info.sortKey);
+        json << ",\"gameFlags\":" << static_cast<int>(material->info.gameFlags);
+        json << ",\"surfaceTypeBits\":" << material->info.surfaceTypeBits;
+        // Which state bits each technique uses; 0xFF means the technique is absent.
+        json << ",\"stateBitsEntry\":[";
+        for (size_t i = 0; i < std::extent_v<decltype(material->stateBitsEntry)>; i++)
+            json << (i ? "," : "") << static_cast<int>(static_cast<unsigned char>(material->stateBitsEntry[i]));
+        json << "]";
+        json << ",\"stateBits\":[";
+        for (unsigned i = 0; i < material->stateBitsCount && material->stateBitsTable; i++)
+        {
+            const auto& bits = material->stateBitsTable[i];
+            json << (i ? "," : "") << "[" << bits.loadBits.raw[0] << "," << bits.loadBits.raw[1] << "]";
+        }
+        json << "],\"textures\":[";
+        for (unsigned i = 0; i < material->textureCount && material->textureTable; i++)
+        {
+            const auto& def = material->textureTable[i];
+            const char* imageName = (def.semantic != TS_WATER_MAP && def.u.image) ? def.u.image->name : "";
+            json << (i ? "," : "") << "{\"nameHash\":" << def.nameHash << ",\"semantic\":" << static_cast<int>(def.semantic)
+                 << ",\"image\":" << Quote(imageName) << "}";
+        }
+        json << "]}";
+    }
+} // namespace
