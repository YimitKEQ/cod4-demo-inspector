+#pragma once
+
+#include "Dumping/AbstractAssetDumper.h"
+#include "Game/IW3/IW3.h"
+
+namespace gfx_world
+{
+    // Writes the compiled render world as two files beside each other:
+    //   <map>.world.bin   raw GfxWorldVertex array, then the uint16 index array
+    //   <map>.world.json  surfaces, materials, static models, lightmaps, sun
+    // The JSON describes the byte layout so a consumer never has to guess.
+    class DumperIW3 final : public AbstractAssetDumper<IW3::AssetGfxWorld>
+    {
+    protected:
+        void DumpAsset(AssetDumpingContext& context, const XAssetInfo<IW3::GfxWorld>& asset) override;
+    };
+} // namespace gfx_world
