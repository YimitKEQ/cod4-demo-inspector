+namespace gfx_world
+{
+    void DumperIW3::DumpAsset(AssetDumpingContext& context, const XAssetInfo<GfxWorld>& asset)
+    {
+        const auto* world = asset.Asset();
+        const auto base = BaseName(asset.m_name);
+
+        // Geometry: vertices first, indices straight after.
+        const auto binName = base + ".world.bin";
+        {
+            const auto bin = context.OpenAssetFile(binName);
+            if (!bin)
+                return;
+            if (world->vd.vertices && world->vertexCount)
+                bin->write(reinterpret_cast<const char*>(world->vd.vertices), sizeof(GfxWorldVertex) * world->vertexCount);
+            if (world->indices && world->indexCount)
+                bin->write(reinterpret_cast<const char*>(world->indices), sizeof(uint16_t) * world->indexCount);
+        }
+
+        const auto jsonFile = context.OpenAssetFile(base + ".world.json");
+        if (!jsonFile)
+            return;
+        auto& json = *jsonFile;
+        json << std::setprecision(9);
+
+        json << "{\"format\":\"oat-iw3-gfxworld-1\",\"name\":" << Quote(world->name) << ",\"baseName\":" << Quote(world->baseName);
+        json << ",\"bin\":" << Quote(binName.c_str());
+        json << ",\"vertexStride\":" << sizeof(GfxWorldVertex) << ",\"vertexCount\":" << world->vertexCount;
+        json << ",\"indexOffset\":" << sizeof(GfxWorldVertex) * world->vertexCount << ",\"indexCount\":" << world->indexCount;
+        json << ",\"mins\":";
+        WriteFloats(json, world->mins, 3);
+        json << ",\"maxs\":";
+        WriteFloats(json, world->maxs, 3);
+
+        json << ",\"sun\":{\"name\":" << Quote(world->sunParse.name) << ",\"ambientScale\":" << world->sunParse.ambientScale
+             << ",\"ambientColor\":";
+        WriteFloats(json, world->sunParse.ambientColor, 3);
+        json << ",\"diffuseFraction\":" << world->sunParse.diffuseFraction << ",\"sunLight\":" << world->sunParse.sunLight << ",\"sunColor\":";
+        WriteFloats(json, world->sunParse.sunColor, 3);
+        json << ",\"diffuseColor\":";
+        WriteFloats(json, world->sunParse.diffuseColor, 3);
+        json << ",\"angles\":";
+        WriteFloats(json, world->sunParse.angles, 3);
+        json << ",\"colorFromBsp\":";
+        WriteFloats(json, world->sunColorFromBsp, 3);
+        json << "}";
+
+        // Sky surfaces are drawn by the sky pass, not the world pass.
+        json << ",\"skySurfaces\":[";
+        for (int i = 0; i < world->skySurfCount && world->skyStartSurfs; i++)
+            json << (i ? "," : "") << world->skyStartSurfs[i];
+        json << "],\"skyImage\":" << Quote(world->skyImage ? world->skyImage->name : "");
+
+        // Materials once each, surfaces refer to them by index.
+        std::vector<const Material*> materials;
+        std::unordered_map<const Material*, size_t> materialIndex;
+        const auto indexOf = [&](const Material* material) -> long long
+        {
+            if (!material)
+                return -1;
+            const auto found = materialIndex.find(material);
+            if (found != materialIndex.end())
+                return static_cast<long long>(found->second);
+            materialIndex.emplace(material, materials.size());
+            materials.push_back(material);
+            return static_cast<long long>(materials.size() - 1);
+        };
+
+        json << ",\"surfaceCount\":" << world->surfaceCount << ",\"staticSurfaceCount\":" << world->dpvs.staticSurfaceCount;
+        json << ",\"surfaces\":[";
+        for (int i = 0; i < world->surfaceCount && world->dpvs.surfaces; i++)
+        {
+            const auto& surface = world->dpvs.surfaces[i];
+            json << (i ? "," : "") << "[" << indexOf(surface.material) << "," << surface.tris.firstVertex << "," << surface.tris.vertexCount << ","
+                 << surface.tris.triCount << "," << surface.tris.baseIndex << "," << static_cast<int>(surface.lightmapIndex) << ","
+                 << static_cast<int>(static_cast<unsigned char>(surface.flags)) << "]";
+        }
+        json << "],\"surfaceFields\":[\"material\",\"firstVertex\",\"vertexCount\",\"triCount\",\"baseIndex\",\"lightmap\",\"flags\"]";
+
+        // Brush models: model 0 is the world, the rest are movers and script brushes.
+        json << ",\"models\":[";
+        for (int i = 0; i < world->modelCount && world->models; i++)
+        {
+            const auto& model = world->models[i];
+            json << (i ? "," : "") << "{\"start\":" << model.startSurfIndex << ",\"count\":" << model.surfaceCount << ",\"bounds\":";
+            WriteFloats(json, &model.bounds[0][0], 6);
+            json << "}";
+        }
+        json << "]";
+
+        // Static models: every placed prop the game draws, already resolved.
+        json << ",\"staticModels\":[";
+        for (unsigned i = 0; i < world->dpvs.smodelCount && world->dpvs.smodelDrawInsts; i++)
+        {
+            const auto& inst = world->dpvs.smodelDrawInsts[i];
+            json << (i ? "," : "") << "{\"model\":" << Quote(inst.model ? inst.model->name : "") << ",\"origin\":";
+            WriteFloats(json, inst.placement.origin, 3);
+            json << ",\"axis\":";
+            WriteFloats(json, &inst.placement.axis[0][0], 9);
+            json << ",\"scale\":" << inst.placement.scale << ",\"cullDist\":" << inst.cullDist << ",\"flags\":"
+                 << static_cast<int>(static_cast<unsigned char>(inst.flags)) << "}";
+        }
+        json << "]";
+
+        // Lightmaps: pixel data when the zone carries it.
+        json << ",\"lightmaps\":[";
+        for (int i = 0; i < world->lightmapCount && world->lightmaps; i++)
+        {
+            json << (i ? "," : "") << "{\"primary\":";
+            if (!DumpLoadDef(context, world->lightmaps[i].primary, base + ".lm" + std::to_string(i) + "_primary.bin", json))
+                json << Quote(world->lightmaps[i].primary ? world->lightmaps[i].primary->name : "");
+            json << ",\"secondary\":";
+            if (!DumpLoadDef(context, world->lightmaps[i].secondary, base + ".lm" + std::to_string(i) + "_secondary.bin", json))
+                json << Quote(world->lightmaps[i].secondary ? world->lightmaps[i].secondary->name : "");
+            json << "}";
+        }
+        json << "]";
+
+        // Material table last, it grew while the surfaces were written.
+        json << ",\"materials\":[";
+        for (size_t i = 0; i < materials.size(); i++)
+        {
+            json << (i ? "," : "");
+            WriteMaterial(json, materials[i]);
+        }
+        json << "]}";
+    }
+} // namespace gfx_world
