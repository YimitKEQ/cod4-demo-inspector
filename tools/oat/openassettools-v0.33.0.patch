+    // A plain JSON copy of the reconstructed tracks, for tools that want the
+    // animation without parsing the compiled xanim format. Values stay in their
+    // quantised form; the consumer decodes them.
+    void WriteJsonXAnim(std::ostream& out, const std::string& name, const CommonXAnimParts& parts)
+    {
+        const auto ints = [&out](const auto& values, const auto& get, const size_t width)
+        {
+            out << "[";
+            bool first = true;
+            for (const auto& v : values)
+                for (size_t k = 0; k < width; k++)
+                {
+                    out << (first ? "" : ",") << static_cast<int>(get(v, k));
+                    first = false;
+                }
+            out << "]";
+        };
+        const auto floats3 = [&out](const std::array<float, 3>& v)
+        {
+            out << "[" << v[0] << "," << v[1] << "," << v[2] << "]";
+        };
+
+        out << std::setprecision(9);
+        out << "{\"format\":\"oat-xanim-json-1\",\"name\":\"" << name << "\",\"frames\":" << parts.m_num_frames
+            << ",\"fps\":" << parts.m_frame_rate << ",\"looped\":" << (parts.m_looped ? "true" : "false") << ",\"bones\":[";
+        for (size_t b = 0; b < parts.m_bone_tracks.size(); b++)
+        {
+            const auto& track = parts.m_bone_tracks[b];
+            out << (b ? "," : "") << "{\"name\":\"" << track.m_name << "\",\"q\":{\"type\":" << static_cast<int>(track.m_quat.m_type)
+                << ",\"idx\":";
+            ints(track.m_quat.m_indices, [](const uint16_t v, size_t) { return v; }, 1);
+            out << ",\"v4\":";
+            ints(track.m_quat.m_frames, [](const CommonXQuat& v, const size_t k) { return v.value[k]; }, 4);
+            out << ",\"v2\":";
+            ints(track.m_quat.m_frames2, [](const CommonXQuat2& v, const size_t k) { return v.value[k]; }, 2);
+            out << "},\"t\":{\"type\":" << static_cast<int>(track.m_trans.m_type) << ",\"idx\":";
+            ints(track.m_trans.m_indices, [](const uint16_t v, size_t) { return v; }, 1);
+            out << ",\"mins\":";
+            floats3(track.m_trans.m_mins);
+            out << ",\"size\":";
+            floats3(track.m_trans.m_size);
+            out << ",\"c\":";
+            floats3(track.m_trans.m_constant);
+            out << ",\"u8\":";
+            ints(track.m_trans.m_frames_u8, [](const CommonVec3U8& v, const size_t k) { return v.value[k]; }, 3);
+            out << ",\"u16\":";
+            ints(track.m_trans.m_frames_u16, [](const CommonVec3U16& v, const size_t k) { return v.value[k]; }, 3);
+            out << "}}";
+        }
+        out << "]";
+        if (parts.m_delta_track && parts.m_delta_track->m_trans)
+        {
+            const auto& d = *parts.m_delta_track->m_trans;
+            out << ",\"delta\":{\"small\":" << (d.m_small_trans ? "true" : "false") << ",\"idx\":";
+            ints(d.m_indices, [](const uint16_t v, size_t) { return v; }, 1);
+            out << ",\"mins\":";
+            floats3(d.m_mins);
+            out << ",\"size\":";
+            floats3(d.m_size);
+            if (d.m_constant)
+            {
+                out << ",\"c\":";
+                floats3(*d.m_constant);
+            }
+            out << ",\"u8\":";
+            ints(d.m_frames_u8, [](const CommonVec3U8& v, const size_t k) { return v.value[k]; }, 3);
+            out << ",\"u16\":";
+            ints(d.m_frames_u16, [](const CommonVec3U16& v, const size_t k) { return v.value[k]; }, 3);
+            out << "}";
+        }
+        out << "}";
+    }
